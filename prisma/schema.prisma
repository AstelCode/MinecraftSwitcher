// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../src/infrastructure/database/postgres/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum VersionType {
  FORGE
  OPTIFINE
  JAVA
}

model User {
  id            BigInt  @id @default(autoincrement())
  email         String  @unique
  nickname      String
  password      String
  recovery_key  String?
  is_admin      Boolean @default(false)
  is_superadmin Boolean @default(false)

  packs     Pack[]
  shaders   Shader[]
  mods      Mod[]
  comments  Comment[]
  favorites Favorite[]

  // Relación invertida: Ahora Image guarda el userId.
  // Al borrar el User, el onDelete: Cascade en Image eliminará la foto.
  image Image? @relation("UserImage")
}

model Pack {
  id          BigInt      @id @default(autoincrement())
  max_version Int
  min_version Int
  versionType VersionType
  name        String
  description String?

  shaders Shader[]
  mods    Mod[]

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId BigInt?

  comments  Comment[]
  favorites Favorite[]

  // Galería de imágenes (1:N)
  images Image[] @relation("packImage")

  // Imagen principal (1:1). Ahora la referencia está en la tabla Image.
  principalImage Image? @relation("PackPrincipalImage")
}

model Shader {
  id          BigInt @id @default(autoincrement())
  name        String
  description String @default("")
  packs       Pack[]
  weight      Int
  src         String

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId BigInt?

  comments          Comment[]
  conflicts         Conflict[]
  versionType       VersionType
  shaderDependecies ShaderDependecy[]
  favorites         Favorite[]

  // Galería de imágenes (1:N)
  images Image[] @relation("shaderImage")

  // Imagen principal (1:1)
  principalImage Image? @relation("ShaderPrincipalImage")
}

model Mod {
  id          BigInt @id @default(autoincrement())
  name        String
  description String @default("")
  min_version Int
  max_version Int
  src         String
  weight      Int
  packs       Pack[]

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId BigInt?

  comments Comment[]

  conflictsFrom Conflict[] @relation("ModConflicts")
  conflictsTo   Conflict[] @relation("ModConflictTarget")

  requiredBy        ModDependency[]   @relation("RequiredBy")
  modDependencies   ModDependency[]   @relation("ModDependencies")
  versionType       VersionType
  shaderDependecies ShaderDependecy[]
  favorites         Favorite[]

  // Galería de imágenes (1:N)
  images Image[] @relation("modImage")

  // Imagen principal (1:1)
  principalImage Image? @relation("ModPrincipalImage")
}

model Comment {
  id   BigInt @id @default(autoincrement())
  text String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId BigInt

  pack     Pack?   @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId   BigInt?
  shader   Shader? @relation(fields: [shaderId], references: [id], onDelete: Cascade)
  shaderId BigInt?
  mod      Mod?    @relation(fields: [modId], references: [id], onDelete: Cascade)
  modId    BigInt?

  @@map("Comments")
}

model Image {
  id  BigInt @id @default(autoincrement())
  src String

  // ----------------------------------------------------
  // IMÁGENES DE GALERÍA (Relación 1:N)
  // ----------------------------------------------------
  mod      Mod?    @relation("modImage", fields: [modId], references: [id], onDelete: Cascade)
  modId    BigInt?
  shader   Shader? @relation("shaderImage", fields: [shaderId], references: [id], onDelete: Cascade)
  shaderId BigInt?
  pack     Pack?   @relation("packImage", fields: [packId], references: [id], onDelete: Cascade)
  packId   BigInt?

  // ----------------------------------------------------
  // IMAGEN DE PERFIL DE USUARIO (Relación 1:1)
  // ----------------------------------------------------
  user   User?   @relation("UserImage", fields: [userId], references: [id], onDelete: Cascade)
  userId BigInt? @unique

  // ----------------------------------------------------
  // IMÁGENES PRINCIPALES (Relación 1:1)
  // ----------------------------------------------------
  packPrincipal   Pack?   @relation("PackPrincipalImage", fields: [packPrincipalId], references: [id], onDelete: Cascade)
  packPrincipalId BigInt? @unique

  shaderPrincipal   Shader? @relation("ShaderPrincipalImage", fields: [shaderPrincipalId], references: [id], onDelete: Cascade)
  shaderPrincipalId BigInt? @unique

  modPrincipal   Mod?    @relation("ModPrincipalImage", fields: [modPrincipalId], references: [id], onDelete: Cascade)
  modPrincipalId BigInt? @unique
}

model Conflict {
  id BigInt @id @default(autoincrement())

  conflictshaderId BigInt?
  conflictShader   Shader? @relation(fields: [conflictshaderId], references: [id], onDelete: Cascade)

  modId BigInt
  mod   Mod    @relation("ModConflicts", fields: [modId], references: [id], onDelete: Cascade)

  conflictModId BigInt?
  conflictMod   Mod?    @relation("ModConflictTarget", fields: [conflictModId], references: [id], onDelete: Cascade)

  @@map("Conflicts")
}

model ModDependency {
  modId        BigInt
  dependencyId BigInt

  mod        Mod @relation("ModDependencies", fields: [modId], references: [id], onDelete: Cascade)
  dependency Mod @relation("RequiredBy", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([modId, dependencyId])
}

model ShaderDependecy {
  shaderId BigInt
  modId    BigInt

  shader Shader @relation(fields: [shaderId], references: [id], onDelete: Cascade)
  mod    Mod    @relation(fields: [modId], references: [id], onDelete: Cascade)

  @@id([shaderId, modId])
}

model Favorite {
  id BigInt @id @default(autoincrement())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId BigInt

  mod      Mod?    @relation(fields: [modId], references: [id], onDelete: Cascade)
  modId    BigInt?
  pack     Pack?   @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId   BigInt?
  shader   Shader? @relation(fields: [shaderId], references: [id], onDelete: Cascade)
  shaderId BigInt?

  createdAt DateTime @default(now())

  @@unique([userId, modId])
  @@unique([userId, packId])
  @@unique([userId, shaderId])
}
