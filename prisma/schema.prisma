// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../src/infrastructure/database/postgres/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum VersionType {
  FORGE
  OPTIFINE
  JAVA
}

model User {
  id           BigInt  @id @default(autoincrement())
  email        String  @unique
  nickname     String
  password     String
  recovery_key String?
  is_admin     Boolean @default(false)
  is_superadmin Boolean @default(false)

  packs    Pack[]
  shaders  Shader[]
  mods     Mod[]
  comments Comment[]
  favorites Favorite[]

  // Nota: Al borrar el User, esta fila se elimina. La imagen en la base de datos quedará huérfana. 
  // Para que la imagen se borre, tendrías que pasar userId al modelo Image.
  image   Image?  @relation(fields: [imageId], references: [id])
  imageId BigInt?
}

model Pack {
  id          BigInt      @id @default(autoincrement())
  max_version Int
  min_version Int
  versionType VersionType
  name        String
  description String?

  shaders Shader[]
  mods    Mod[]

  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId BigInt?

  comments Comment[]
  images   Image[]   @relation("packImage")
  favorites Favorite[]

  // Nota: Igual que con User, si se borra el Pack, la imagen "Principal" no se borra automáticamente de la tabla Image.
  principalImage   Image?  @relation("PrincipalImage", fields: [principalImageId], references: [id])
  principalImageId BigInt?
}

model Shader {
  id          BigInt @id @default(autoincrement())
  name        String
  description String @default("")
  packs       Pack[]
  weight      Int
  src         String

  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId BigInt?

  comments          Comment[]
  images            Image[]           @relation("shaderImage")
  conflicts         Conflict[]
  versionType       VersionType
  shaderDependecies ShaderDependecy[]
  favorites         Favorite[]

  principalImage   Image?  @relation("PrincipalImage", fields: [principalImageId], references: [id])
  principalImageId BigInt?
}

model Mod {
  id          BigInt @id @default(autoincrement())
  name        String
  description String @default("")
  min_version Int
  max_version Int
  src         String
  weight      Int
  packs       Pack[]

  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId BigInt?

  comments Comment[]
  images   Image[]   @relation("modImage")

  conflictsFrom Conflict[] @relation("ModConflicts")
  conflictsTo   Conflict[] @relation("ModConflictTarget")

  requiredBy        ModDependency[]   @relation("RequiredBy")
  modDependencies   ModDependency[]   @relation("ModDependencies")
  versionType       VersionType
  shaderDependecies ShaderDependecy[]
  favorites         Favorite[]

  principalImage   Image?  @relation("PrincipalImage", fields: [principalImageId], references: [id])
  principalImageId BigInt?
}

model Comment {
  id   BigInt @id @default(autoincrement())
  text String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId BigInt

  // Cascada: Si se borra el pack, shader o mod, el comentario desaparece.
  pack     Pack?   @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId   BigInt?
  shader   Shader? @relation(fields: [shaderId], references: [id], onDelete: Cascade)
  shaderId BigInt?
  mod      Mod?    @relation(fields: [modId], references: [id], onDelete: Cascade)
  modId    BigInt?

  @@map("Comments")
}

model Image {
  id  BigInt @id @default(autoincrement())
  src String

  // Cascada: Si se borra la entidad a la que pertenece la galería de imágenes, las imágenes se borran.
  mod      Mod?    @relation("modImage", fields: [modId], references: [id], onDelete: Cascade)
  modId    BigInt?
  shader   Shader? @relation("shaderImage", fields: [shaderId], references: [id], onDelete: Cascade)
  shaderId BigInt?
  pack     Pack?   @relation("packImage", fields: [packId], references: [id], onDelete: Cascade)
  packId   BigInt?

  users            User[]
  packsPrincipal   Pack[]   @relation("PrincipalImage")
  shadersPrincipal Shader[] @relation("PrincipalImage")
  modsPrincipal    Mod[]    @relation("PrincipalImage")
}

model Conflict {
  id BigInt @id @default(autoincrement())

  // Cascada para conflictos de dependencias
  conflictshaderId BigInt?
  conflictShader   Shader? @relation(fields: [conflictshaderId], references: [id], onDelete: Cascade)

  modId BigInt
  mod   Mod    @relation("ModConflicts", fields: [modId], references: [id], onDelete: Cascade)

  conflictModId BigInt?
  conflictMod   Mod?    @relation("ModConflictTarget", fields: [conflictModId], references: [id], onDelete: Cascade)

  @@map("Conflicts")
}

model ModDependency {
  modId        BigInt
  dependencyId BigInt

  // Cascada: Si borras el mod original o su dependencia, la relación se elimina.
  mod        Mod @relation("ModDependencies", fields: [modId], references: [id], onDelete: Cascade)
  dependency Mod @relation("RequiredBy", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([modId, dependencyId])
}

model ShaderDependecy {
  shaderId BigInt
  modId    BigInt

  // Cascada: Al borrar el shader o el mod, se elimina esta tabla intermedia.
  shader Shader @relation(fields: [shaderId], references: [id], onDelete: Cascade)
  mod    Mod    @relation(fields: [modId], references: [id], onDelete: Cascade)

  @@id([shaderId, modId])
}

model Favorite {
  id     BigInt @id @default(autoincrement())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId BigInt

  // Solo uno de los tres será no-null
  mod      Mod?    @relation(fields: [modId], references: [id], onDelete: Cascade)
  modId    BigInt?
  pack     Pack?   @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId   BigInt?
  shader   Shader? @relation(fields: [shaderId], references: [id], onDelete: Cascade)
  shaderId BigInt?

  createdAt DateTime @default(now())

  // Un usuario no puede tener el mismo item favorito dos veces
  @@unique([userId, modId])
  @@unique([userId, packId])
  @@unique([userId, shaderId])
}
