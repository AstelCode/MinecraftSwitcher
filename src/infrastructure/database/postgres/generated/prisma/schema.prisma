// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../src/infrastructure/database/postgres/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum VersionType {
  FORGE
  OPTIFINE
  JAVA
}

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique
  nickname     String
  password     String
  recovery_key String?
  is_admin     Boolean   @default(false)
  packs        Pack[]
  shaders      Shader[]
  mods         Mod[]
  comments     Comment[]
  image        Image?    @relation(fields: [imageId], references: [id])
  imageId      BigInt?
}

model Pack {
  id          BigInt      @id @default(autoincrement())
  max_version Int
  min_version Int
  versionType VersionType
  name        String
  description String?

  shaders Shader[]
  mods    Mod[]

  author   User   @relation(fields: [authorId], references: [id])
  authorId BigInt

  comments Comment[]
  images   Image[]   @relation("packImage")

  principalImage   Image?  @relation("PrincipalImage", fields: [principalImageId], references: [id])
  principalImageId BigInt?
}

model Shader {
  id          BigInt @id @default(autoincrement())
  name        String
  description String @default("")
  packs       Pack[]
  weight      Int
  src         String

  author   User   @relation(fields: [authorId], references: [id])
  authorId BigInt

  comments          Comment[]
  images            Image[]           @relation("shaderImage")
  conflicts         Conflict[]
  versionType       VersionType
  shaderDependecies ShaderDependecy[]

  principalImage   Image?  @relation("PrincipalImage", fields: [principalImageId], references: [id])
  principalImageId BigInt?
}

model Mod {
  id          BigInt @id @default(autoincrement())
  name        String
  description String @default("")
  min_version Int
  max_version Int
  src         String
  weight      Int
  packs       Pack[]

  author   User   @relation(fields: [authorId], references: [id])
  authorId BigInt

  comments Comment[]
  images   Image[]   @relation("modImage")

  conflictsFrom Conflict[] @relation("ModConflicts")
  conflictsTo   Conflict[] @relation("ModConflictTarget")

  requiredBy        ModDependency[]   @relation("RequiredBy")
  modDependencies   ModDependency[]   @relation("ModDependencies")
  versionType       VersionType
  shaderDependecies ShaderDependecy[]
  principalImage    Image?            @relation("PrincipalImage", fields: [principalImageId], references: [id])
  principalImageId  BigInt?
}

model Comment {
  id   BigInt @id @default(autoincrement())
  text String

  author   User   @relation(fields: [authorId], references: [id])
  authorId BigInt

  pack     Pack?   @relation(fields: [packId], references: [id])
  packId   BigInt?
  shader   Shader? @relation(fields: [shaderId], references: [id])
  shaderId BigInt?
  mod      Mod?    @relation(fields: [modId], references: [id])
  modId    BigInt?

  @@map("Comments")
}

model Image {
  id               BigInt   @id @default(autoincrement())
  src              String
  basePath         String
  mod              Mod?     @relation("modImage", fields: [modId], references: [id])
  modId            BigInt?
  shader           Shader?  @relation("shaderImage", fields: [shaderId], references: [id])
  shaderId         BigInt?
  pack             Pack?    @relation("packImage", fields: [packId], references: [id])
  packId           BigInt?
  users            User[]
  packsPrincipal   Pack[]   @relation("PrincipalImage")
  shadersPrincipal Shader[] @relation("PrincipalImage")
  modsPrincipal    Mod[]    @relation("PrincipalImage")
}

model Conflict {
  id BigInt @id @default(autoincrement())

  conflictshaderId BigInt?
  conflictShader   Shader? @relation(fields: [conflictshaderId], references: [id])

  modId BigInt
  mod   Mod    @relation("ModConflicts", fields: [modId], references: [id])

  conflictModId BigInt?
  conflictMod   Mod?    @relation("ModConflictTarget", fields: [conflictModId], references: [id])

  @@map("Conflicts")
}

model ModDependency {
  modId        BigInt
  dependencyId BigInt

  mod        Mod @relation("ModDependencies", fields: [modId], references: [id])
  dependency Mod @relation("RequiredBy", fields: [dependencyId], references: [id])

  @@id([modId, dependencyId])
}

model ShaderDependecy {
  shaderId BigInt
  modId    BigInt

  shader Shader @relation(fields: [shaderId], references: [id])
  mod    Mod    @relation(fields: [modId], references: [id])

  @@id([shaderId, modId])
}
